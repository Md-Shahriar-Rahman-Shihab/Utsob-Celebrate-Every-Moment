// ==============================================================================
// UTSOB (উৎসব) — Prisma Database Schema
// ==============================================================================
// Target Engine: PostgreSQL 16+ on Neon Serverless
// Design Pattern: Normalized Relational with JSONB Canvas Scene Graphs
// ==============================================================================

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------------------

enum UserRole {
  USER
  CREATOR
  ADMIN
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CardStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum ShareAccessType {
  VIEW_ONLY
  CAN_DUPLICATE
}

enum AssetType {
  IMAGE
  STICKER
  FONT
  BACKGROUND
  AUDIO
}

enum InvitationStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum RSVPStatus {
  ATTENDING
  DECLINED
  TENTATIVE
}

// ------------------------------------------------------------------------------
// Identity & Authentication Domain (Auth.js Compatible)
// ------------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  phoneNumber   String?
  locale        String    @default("bn-BD")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  accounts      Account[]
  sessions      Session[]
  cards         Card[]
  templates     Template[]    @relation("CreatorTemplates")
  assets        Asset[]
  aiGenerations AIGeneration[]
  invitations   Invitation[]  @relation("UserInvitations")

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ------------------------------------------------------------------------------
// Category & Template Catalog Domain
// ------------------------------------------------------------------------------

model Category {
  id            String     @id @default(uuid())
  slug          String     @unique
  nameEn        String
  nameBn        String
  descriptionEn String?    @db.Text
  descriptionBn String?    @db.Text
  icon          String?
  sortOrder     Int        @default(0)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  templates     Template[]

  @@index([slug])
  @@index([isActive, sortOrder])
  @@map("categories")
}

model Template {
  id            String         @id @default(uuid())
  slug          String         @unique
  titleEn       String
  titleBn       String
  descriptionEn String?        @db.Text
  descriptionBn String?        @db.Text
  thumbnailUrl  String
  canvasJSON    Json
  width         Int            @default(1080)
  height        Int            @default(1920)
  isPremium     Boolean        @default(false)
  priceBdt      Decimal?       @db.Decimal(10, 2)
  categoryId    String
  createdById   String?
  status        TemplateStatus @default(DRAFT)
  viewCount     Int            @default(0)
  useCount      Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator       User?          @relation("CreatorTemplates", fields: [createdById], references: [id], onDelete: SetNull)
  cards         Card[]

  @@index([categoryId, status])
  @@index([isPremium])
  @@index([slug])
  @@map("templates")
}

// ------------------------------------------------------------------------------
// User Card Creations & Sharing Domain
// ------------------------------------------------------------------------------

model Card {
  id           String     @id @default(uuid())
  title        String
  canvasJSON   Json
  thumbnailUrl String?
  width        Int        @default(1080)
  height       Int        @default(1920)
  userId       String
  templateId   String?
  isPublic     Boolean    @default(false)
  status       CardStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  template     Template?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  shareLinks   ShareLink[]
  invitation   Invitation?

  @@index([userId, status])
  @@index([templateId])
  @@map("cards")
}

model ShareLink {
  id             String          @id @default(uuid())
  cardId         String
  shareToken     String          @unique
  accessType     ShareAccessType @default(VIEW_ONLY)
  passwordHash   String?
  expiresAt      DateTime?
  viewCount      Int             @default(0)
  lastAccessedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@map("share_links")
}

// ------------------------------------------------------------------------------
// Media Assets & AI Domain
// ------------------------------------------------------------------------------

model Asset {
  id            String    @id @default(uuid())
  name          String
  type          AssetType @default(IMAGE)
  url           String
  publicId      String
  mimeType      String
  width         Int?
  height        Int?
  sizeBytes     Int       @default(0)
  userId        String?
  isSystemAsset Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([isSystemAsset, type])
  @@map("assets")
}

model AIGeneration {
  id            String   @id @default(uuid())
  userId        String
  prompt        String   @db.Text
  promptBn      String?  @db.Text
  generatedText String   @db.Text
  category      String
  tone          String
  modelVersion  String
  inputTokens   Int?
  outputTokens  Int?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_generations")
}

// ------------------------------------------------------------------------------
// Digital Invitation & RSVP Domain (Schema Prepared for Future Phases)
// ------------------------------------------------------------------------------

model Invitation {
  id           String           @id @default(uuid())
  cardId       String           @unique
  createdById  String
  eventTitle   String
  eventDate    DateTime
  eventEndDate DateTime?
  venueName    String
  venueAddress String           @db.Text
  mapUrl       String?
  maxGuests    Int?
  rsvpDeadline DateTime?
  status       InvitationStatus @default(DRAFT)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  creator User   @relation("UserInvitations", fields: [createdById], references: [id], onDelete: Cascade)
  rsvps   RSVP[]

  @@index([createdById])
  @@index([eventDate])
  @@map("invitations")
}

model RSVP {
  id           String     @id @default(uuid())
  invitationId String
  guestName    String
  guestPhone   String
  guestEmail   String?
  guestCount   Int        @default(1)
  status       RSVPStatus @default(ATTENDING)
  responseNote String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([invitationId, guestPhone])
  @@index([invitationId, status])
  @@map("rsvps")
}

