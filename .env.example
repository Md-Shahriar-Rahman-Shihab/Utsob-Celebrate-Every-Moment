# ==============================================================================
# UTSOB (উৎসব) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local to source control.
# ==============================================================================

# Node Environment
NODE_ENV="development"
PORT=3000

# Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# PostgreSQL Database (Neon Serverless)
# ------------------------------------------------------------------------------
# Pooled connection string (with ?pgbouncer=true or via Neon Pooler endpoint)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/utsob?sslmode=require&pgbouncer=true"

# Direct connection string for Prisma migrations (bypassing connection pooler)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/utsob?sslmode=require"

# ------------------------------------------------------------------------------
# Auth.js / NextAuth v5 Configuration
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-secure-32-character-random-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Optional OAuth Providers
AUTH_GOOGLE_ID="google-client-id-placeholder"
AUTH_GOOGLE_SECRET="google-client-secret-placeholder"

# ------------------------------------------------------------------------------
# Cloudinary (Media Storage & Image CDN)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="utsob-cloud"
CLOUDINARY_API_KEY="cloudinary-api-key-placeholder"
CLOUDINARY_API_SECRET="cloudinary-api-secret-placeholder"

# ------------------------------------------------------------------------------
# Google Gemini API (Bengali Greetings & Poetry AI)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="gemini-api-key-placeholder"
